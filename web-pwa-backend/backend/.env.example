PORT=8787
CORS_ORIGIN=http://localhost:5173
DATA_FILE=./data/ute-notice-db.json
SYNC_CRON=*/15 * * * *
REMINDER_GRACE_MINUTES=20

# Generate with: npm run generate:vapid
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=replace_with_generated_public_key
VAPID_PRIVATE_KEY=replace_with_generated_private_key

# Optional email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="UTE Notice <no-reply@example.com>"
